{
  "name": "mount-vernon-trail-firestore-rules",
  "version": "0.0.0",
  "private": true,
  "description": "Security-rules tests for firestore.rules, run against the Firestore emulator.",
  "scripts": {
    "test": "firebase emulators:exec --project mvt-rules-test --only firestore --config ../firebase.json \"jest --ci\"",
    "test:watch": "firebase emulators:exec --project mvt-rules-test --only firestore --config ../firebase.json \"jest --watch\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "firebase": "^11.10.0",
    "firebase-tools": "^13.35.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.2"
  }
}
