# Port the server binds. Render sets this automatically.
PORT=8080

# Google OAuth client for the MVT-owned Google account (the account that owns
# the shared Photos albums). GOOGLE_REDIRECT_URI must exactly match the
# "Authorized redirect URI" on the OAuth client AND this server's
# /auth/callback route, e.g. https://<your-host>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional. The admin OAuth flow stores the MVT refresh token in Redis; set
# this as a durable backup so a wiped free-tier Redis does not require redoing
# the sign-in dance. Re-seeds Redis on first use.
GOOGLE_REFRESH_TOKEN=

# Upstash Redis. Caches the Google access token across replicas and holds the
# single-use OAuth state nonces.
#
# OPTIONAL LOCALLY: leave both blank and the server uses an in-memory store, so
# you can run it before provisioning Upstash. Tokens are then lost on restart
# and not shared between processes.
#
# REQUIRED when NODE_ENV=production — the server refuses to start without them,
# because losing the MVT refresh token on every restart would make uploads fail
# unpredictably.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase service account, used to verify the Firebase ID token that every
# /api request must carry. Get it from:
#   Firebase console -> Project settings -> Service accounts
#   -> Generate new private key
#
# Accepts EITHER form:
#
#   1. A path to the downloaded key file — easiest locally:
#        FIREBASE_SERVICE_ACCOUNT_JSON=./secrets/friends-of-mvt-key.json
#
#   2. The file contents inlined as one line — needed on Render, which has no
#      filesystem to put a key on:
#        FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# If you inline it, do NOT wrap the value in quotes. The private_key field
# contains literal \n escapes, and dotenv turns those into real newlines inside
# a quoted value, which makes the JSON invalid.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated browser origins allowed to call this API. Leave empty to
# allow none — React Native clients send no Origin header and are unaffected.
ALLOWED_ORIGINS=

# Upload limits. Sized for a 512 MB instance: the previous 20 MB x 50 could
# buffer ~1 GB in memory per request.
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES_PER_FILE=10485760
